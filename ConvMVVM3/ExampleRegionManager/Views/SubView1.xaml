<UserControl x:Class="ExampleRegionManager.Views.SubView1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="https://github.com/gellston/ConvMVVM3"
    conv:ViewModelLocator.AutoWireViewModel="True">
    <Border Background="#E8F1FC" Padding="12" Margin="0,0,0,8" CornerRadius="4">
        <StackPanel>
            <TextBlock Text="{Binding InstanceNumber, StringFormat=Item #{0}}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding InstanceId, StringFormat=VM: {0}}" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
