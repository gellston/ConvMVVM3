<Window x:Class="ExampleMvvmBasics.Views.MainWindowView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="https://github.com/gellston/ConvMVVM3"
 conv:ViewModelLocator.AutoWireViewModel="True"
 Title="ConvMVVM3 1.2.0 - MVVM basics" Width="1050" Height="740" MinWidth="850" MinHeight="600">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="MVVM basics" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Generated properties and commands, dependent notifications, and an explicit CanExecute predicate." TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal">
  <StackPanel Width="260"><TextBlock Text="First name"/><TextBox x:Name="FirstNameInput" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Width="260"><TextBlock Text="Last name"/><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
 </StackPanel>
 <Border Grid.Row="1" Background="#E8F1FC" Padding="20" Margin="0,0,0,20">
  <StackPanel><TextBlock Text="{Binding FullName}" FontSize="24"/><TextBlock Text="{Binding Greeting}" Margin="0,8,0,0"/></StackPanel>
 </Border>
 <CheckBox Grid.Row="2" Content="Allow saving (both name fields must also be non-empty)" IsChecked="{Binding AllowSave}" Margin="0,0,0,16"/>
 <StackPanel Grid.Row="3">
  <WrapPanel><Button Content="Save" Command="{Binding SaveCommand}"/><Button Content="Generated increment command" Command="{Binding IncrementCommand}"/><Button Content="Reset" Command="{Binding ResetCommand}"/></WrapPanel>
  <TextBlock Text="{Binding ClickCount, StringFormat=Generated command executions: {0}}" Margin="0,12,0,8"/>
  <TextBlock Text="{Binding SaveCount, StringFormat=Successful saves: {0}}"/>
 </StackPanel>
 <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap"/>
</Grid>
 </Grid>
</Window>
