<Window x:Class="ExampleModuleManager.Views.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="https://github.com/gellston/ConvMVVM3"
    conv:ViewModelLocator.AutoWireViewModel="True"
    Title="{Binding Title}" Width="1050" Height="700" MinWidth="850" MinHeight="600">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Modular application composition" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ContentControl Grid.Row="1" conv:RegionPlugin.RegionName="MainContent"/>
    </Grid>
</Window>
