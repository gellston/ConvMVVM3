<Window x:Class="ExampleRegionManager.Views.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="https://github.com/gellston/ConvMVVM3"
    conv:ViewModelLocator.AutoWireViewModel="True"
    Title="ConvMVVM3 1.2.0 - RegionManager" Width="1180" Height="760" MinWidth="1050" MinHeight="620">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Compare three region hosts" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Pass a customer to a single view, or add distinct instances to multi-view regions." Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="ContentControl - Singleton" FontWeight="SemiBold" Margin="0,0,12,12"/>
            <TextBlock Grid.Column="1" Text="ItemsControl - Transient" FontWeight="SemiBold" Margin="0,0,12,12"/>
            <TextBlock Grid.Column="2" Text="ListBox - Selectable transient views" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Border Grid.Row="1" Background="White" Margin="0,0,12,12">
                <ContentControl conv:RegionPlugin.RegionName="ContentView"/>
            </Border>
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,12">
                <ItemsControl conv:RegionPlugin.RegionName="SubView1"/>
            </ScrollViewer>
            <ListBox Grid.Row="1" Grid.Column="2" conv:RegionPlugin.RegionName="SubView2"
                     HorizontalContentAlignment="Stretch" Margin="0,0,0,12"/>
            <Button Grid.Row="2" Content="Next customer" Command="{Binding SwitchContentCommand}"/>
            <WrapPanel Grid.Row="2" Grid.Column="1">
                <Button Content="Add 3 items" Command="{Binding AddItemsCommand}"/>
                <Button Content="Clear" Command="{Binding ClearItemsCommand}"/>
            </WrapPanel>
            <WrapPanel Grid.Row="2" Grid.Column="2">
                <Button Content="Add 3 items" Command="{Binding AddListCommand}"/>
                <Button Content="Select second" Command="{Binding SelectListCommand}"/>
                <Button Content="Clear" Command="{Binding ClearListCommand}"/>
            </WrapPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="ViewModel navigation history (newest first)" FontWeight="SemiBold" Margin="0,12,0,8"/>
        <ListBox Grid.Row="3" ItemsSource="{Binding NavigationHistory}"/>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</Window>
