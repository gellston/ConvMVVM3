<UserControl x:Class="ExampleModuleManager.Views.BModuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="https://github.com/gellston/ConvMVVM3"
    conv:ViewModelLocator.AutoWireViewModel="True">
    <Border Background="#E8F1FC" Padding="24" CornerRadius="6">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,16"/>
            <TextBlock Text="{Binding InstanceId, StringFormat=VM instance: {0}}"/>
            <TextBlock Text="{Binding NavigationCount, StringFormat=Navigation visits: {0}}" Margin="0,8,0,8"/>
            <TextBlock Text="{Binding LastNavigation}"/>
            <TextBlock Text="This ViewModel receives INavigationAware callbacks through the WPF adapter."
                       TextWrapping="Wrap" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
