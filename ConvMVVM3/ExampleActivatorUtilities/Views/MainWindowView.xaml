<Window x:Class="ExampleActivatorUtilities.Views.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="https://github.com/gellston/ConvMVVM3"
    conv:ViewModelLocator.AutoWireViewModel="True"
    Title="ConvMVVM3 1.2.0 - ActivatorUtilities" Width="1050" Height="600" MinWidth="850" MinHeight="480">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Combine DI services with runtime arguments" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="The container provides IGreetingService. Your inputs provide the name and age."
                       Margin="0,8,0,16" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <StackPanel Width="240"><TextBlock Text="Name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Width="140"><TextBlock Text="Age"/><TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </StackPanel>
        <WrapPanel Grid.Row="2">
            <Button Content="CreateInstance" Command="{Binding GenerateModelCommand}"/>
            <Button Content="Use cached factory" Command="{Binding GenerateWithFactoryCommand}"/>
            <Button Content="Clear list" Command="{Binding ClearModelsCommand}"/>
        </WrapPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding TestModelCollection}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,8,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Method" Binding="{Binding CreationMethod}" Width="150"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="Injected service result" Binding="{Binding Greeting}" Width="*" MinWidth="220"/>
                <DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap"/>
    </Grid>
</Window>
