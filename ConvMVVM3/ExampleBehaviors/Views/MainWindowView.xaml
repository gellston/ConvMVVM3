<Window x:Class="ExampleBehaviors.Views.MainWindowView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="https://github.com/gellston/ConvMVVM3"
 conv:ViewModelLocator.AutoWireViewModel="True"
 Title="ConvMVVM3 1.2.0 - Events and actions" Width="1100" Height="760" MinWidth="900" MinHeight="620">
 
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Events and actions" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Connect events in XAML without code-behind handlers; pass parameters and respect CanExecute." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBox Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"/>
 <CheckBox Grid.Row="1" Content="Allow the event command to execute" IsChecked="{Binding AllowEvents}" Margin="0,0,0,16"/>
 <WrapPanel Grid.Row="2">
  <Button x:Name="EventButton" Content="Click event to command">
   <conv:Interaction.Triggers><conv:EventTrigger EventName="Click"><conv:InvokeCommandAction Command="{Binding EventCommand}" CommandParameter="{Binding Payload}"/></conv:EventTrigger></conv:Interaction.Triggers>
  </Button>
  <Button x:Name="MethodButton" Content="Call ViewModel method">
   <conv:Interaction.Triggers><conv:EventTrigger EventName="Click"><conv:CallMethodAction TargetObject="{Binding}" MethodName="RecordMethodCall"/></conv:EventTrigger></conv:Interaction.Triggers>
  </Button>
  <Button x:Name="PropertyButton" Content="Change this button's content">
   <conv:Interaction.Triggers><conv:EventTrigger EventName="Click"><conv:ChangePropertyAction PropertyName="Content" Value="Changed by ChangePropertyAction"/></conv:EventTrigger></conv:Interaction.Triggers>
  </Button>
 </WrapPanel>
 <ListBox Grid.Row="3" ItemsSource="{Binding Events}" Margin="0,12,0,16"/>
 <StackPanel Grid.Row="4"><TextBlock Text="{Binding EventCount, StringFormat=Event command executions: {0}}"/><TextBlock Text="{Binding MethodCount, StringFormat=Method calls: {0}}" Margin="0,8,0,0"/></StackPanel>
</Grid>
 </Grid>
</Window>
