<Window x:Class="ExampleMessaging.Views.MainWindowView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="https://github.com/gellston/ConvMVVM3"
 conv:ViewModelLocator.AutoWireViewModel="True"
 Title="ConvMVVM3 1.2.0 - Weak-reference messaging" Width="1100" Height="760" MinWidth="900" MinHeight="620">
 <Window.Resources>
 <DataTemplate x:Key="ReceiverTemplate">
  <Grid Margin="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
   <StackPanel Grid.Row="1" Margin="0,12,0,12"><CheckBox Content="Active subscription" IsChecked="{Binding IsActive}"/>
    <TextBlock Text="{Binding Channel, StringFormat=Channel: {0}}" Margin="0,8,0,0"/></StackPanel>
   <TextBlock Grid.Row="2" Text="{Binding ReceivedCount, StringFormat=Messages received: {0}}" Margin="0,0,0,12"/>
   <ListBox Grid.Row="3" ItemsSource="{Binding Messages}"/>
  </Grid>
 </DataTemplate>
</Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Weak-reference messaging" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Publish across ViewModels, separate token channels, and activate or deactivate recipients." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
 <WrapPanel Grid.Row="1"><Button Content="Send to Alpha" Command="{Binding SendAlphaCommand}"/><Button Content="Send to Beta" Command="{Binding SendBetaCommand}"/><Button Content="Move receiver B to Alpha" Command="{Binding MoveRightToAlphaCommand}"/></WrapPanel>
 <Grid Grid.Row="2" Margin="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource ReceiverTemplate}"/>
  <ContentControl Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource ReceiverTemplate}"/>
 </Grid>
 <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap"/>
</Grid>
 </Grid>
</Window>
