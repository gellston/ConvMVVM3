<Window x:Class="ExampleCollections.Views.MainWindowView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="https://github.com/gellston/ConvMVVM3"
 conv:ViewModelLocator.AutoWireViewModel="True"
 Title="ConvMVVM3 1.2.0 - Batch collection updates" Width="1100" Height="760" MinWidth="900" MinHeight="620">
 
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Batch collection updates" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Compare collection notifications for individual changes, AddRange, ReplaceRange and RemoveRange." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <WrapPanel><Button Content="Add 1,000 individually" Command="{Binding LoadIndividuallyCommand}"/><Button Content="AddRange 1,000" Command="{Binding LoadRangeCommand}"/><Button Content="Replace with 200" Command="{Binding ReplaceRangeCommand}"/><Button Content="Remove first 100" Command="{Binding RemoveRangeCommand}"/><Button Content="Clear range" Command="{Binding ClearRangeCommand}"/></WrapPanel>
 <Grid Grid.Row="1" Margin="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,12"><TextBlock Text="ObservableCollection" FontWeight="SemiBold"/><TextBlock Text="{Binding IndividualNotifications, StringFormat=Notifications: {0}}" Margin="0,8,0,0"/></StackPanel>
   <ListBox Grid.Row="1" ItemsSource="{Binding IndividualItems}"/>
  </Grid>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,12"><TextBlock Text="ObservableRangeCollection" FontWeight="SemiBold"/><TextBlock Text="{Binding RangeNotifications, StringFormat=Notifications: {0}}" Margin="0,8,0,4"/><TextBlock Text="{Binding ResetNotifications, StringFormat=Reset events: {0}}"/></StackPanel>
   <ListBox Grid.Row="1" ItemsSource="{Binding Items}"/>
  </Grid>
 </Grid>
 <StackPanel Grid.Row="2"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="Counters cover the most recent operation; preparation clears are excluded." Margin="0,8,0,0"/></StackPanel>
</Grid>
 </Grid>
</Window>
